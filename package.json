{
  "name": "packall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"tauri,marketing,docs\" -c \"magenta,yellow,blue\" \"bun run dev:tauri\" \"bun run dev:marketing\" \"bun run dev:docs\"",
    "dev:tauri": "node scripts/kill-dev-port.cjs && tauri dev",
    "dev:marketing": "cd apps/marketing && bun run dev",
    "dev:docs": "cd apps/docs && bun run dev",
    "build": "bun run build:tauri && bun run build:marketing && bun run build:docs",
    "build:tauri": "tauri build",
    "build:marketing": "cd apps/marketing && bun run build",
    "build:docs": "cd apps/docs && bun run build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-shell": "~2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.2"
  }
}

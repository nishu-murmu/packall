{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxDir",
  "version": "0.1.0",
  "identifier": "app.linuxdir.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LinuxDir - Software Directory",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A graphical directory of essential Linux software",
    "longDescription": "LinuxDir is a graphical directory that categorizes and helps you install essential Linux software. Navigate the entire app with Neovim-style keyboard shortcuts."
  }
}
